{
  "name": "security-mcp",
  "version": "0.1.0",
  "description": "Generic security MCP server — expose your org's policies, risk context, paved roads, and tools to coding agents.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "security-mcp": "./dist/index.js"
  },
  "files": [
    "dist/",
    "presets/",
    "examples/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "prepack": "tsc",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "pretest": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "inspector": "npx @modelcontextprotocol/inspector tsx src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@opentelemetry/api": "^1.9.1",
    "@types/micromatch": "^4.0.10",
    "fast-glob": "^3.3.2",
    "jose": "^6.2.3",
    "micromatch": "^4.0.8",
    "prom-client": "^15.1.3",
    "tar": "^7.5.13",
    "yaml": "^2.6.1",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "@types/tar": "^7.0.87",
    "@vitest/coverage-v8": "^3.2.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "Apache-2.0"
}
