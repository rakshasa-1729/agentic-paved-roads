{
  "name": "security-mcp",
  "version": "0.1.0",
  "description": "Generic security MCP server — expose your org's policies, risk context, paved roads, and tools to coding agents.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "security-mcp": "./dist/index.js"
  },
  "scripts": {
