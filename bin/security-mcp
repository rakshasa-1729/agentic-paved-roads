#!/usr/bin/env bash
#
# Launcher for the security-mcp container that pulls a fresh GitHub token
# from the developer's `gh auth login` on every invocation. Avoids storing
# a PAT in shell rc files, in `~/.cursor/mcp.json`, or anywhere else.
#
# MCP clients (Cursor, Claude Desktop, …) launch this binary instead of
# `docker run` directly. Any extra args are forwarded to docker run, before
# the image name — so callers can attach mounts and pass extra env:
#
#   /abs/path/bin/security-mcp                              # global, no mounts
#   /abs/path/bin/security-mcp -v $PWD:/data/app            # project, with mount
#   EXCEPTION_API_BASE_URL=https://… /abs/path/bin/security-mcp -e EXCEPTION_API_BASE_URL  # forward extra env
#
# Env vars passed through to the container:
#
#   SECURITY_REPO_TOKEN — github token (resolved via `gh auth token`)
#
# Other env vars referenced by tool descriptors (e.g. EXCEPTION_API_BASE_URL,
# EXCEPTION_API_TOKEN for the `exception_tool` HTTP tool) are NOT forwarded
# automatically — set them in your shell and add `-e VAR` to the args
# above when needed.
#
# Requires:
#   - gh installed and `gh auth login` completed for github.com
#   - docker daemon running
#   - security-mcp:latest image built (see Dockerfile)

set -euo pipefail

if ! command -v gh >/dev/null 2>&1; then
  echo "security-mcp: 'gh' CLI not found. Install with: brew install gh" >&2
  exit 1
fi

if ! command -v docker >/dev/null 2>&1; then
  echo "security-mcp: docker not found. Start Docker Desktop." >&2
  exit 1
fi

TOKEN="$(gh auth token --hostname github.com 2>/dev/null || true)"
if [ -z "$TOKEN" ]; then
  echo "security-mcp: 'gh auth token' returned empty. Run: gh auth login --hostname github.com" >&2
  exit 1
fi

exec docker run -i --rm \
  --add-host=host.docker.internal:host-gateway \
  -e SECURITY_REPO_TOKEN="$TOKEN" \
  "$@" \
  security-mcp:latest
